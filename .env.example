# ==============================================================================
# shop-tgbot configuration & secret template
# Reference: Section 18 of project-docs/docs/shop-system-design.md
# ==============================================================================

# --- Required Secrets (Keep out of git, mode 0400 in production) ---
TELEGRAM_BOT_TOKEN=
HCLOUD_TOKEN=
DB_PASSWORD=
CREDENTIAL_KEK=
CLOUDFLARE_TUNNEL_TOKEN=

# --- Administration & Support ---
ADMIN_TELEGRAM_ID=<admin_telegram_id>
SUPPORT_HANDLE=@manova_support
TOTP_ISSUER=shop_manovabot
CARD_HOLDER_NAME="<card_holder_name>"

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=shopbot
DATABASE_NAME=shopbot
DATABASE_SSLMODE=disable

# --- Pricing & FX ---
RATE_SPREAD_IRT_PER_USD=5000
REQUOTE_THRESHOLD_IRT_PER_USD=5000
RATE_MAX_AGE_HOURS=6
RATE_POLL_INTERVAL_SECONDS=300
SWAPWALLET_API_URL=https://swapwallet.app/api/v1/market/prices?pair=USDT/IRT
WALLEX_API_URL=https://api.wallex.ir/v1/markets

# --- Limits & Receipts ---
RECEIPT_MIN_IRR=1000000
RECEIPT_MAX_IRR=500000000
MAX_RAM_GB=16
ORDER_EXPIRY_MINUTES=60
MIN_BILLABLE_MINUTES=60

# --- Floors & Segments (in IRT / Toman) ---
NEW_MAX_SERVERS=1
NEW_FLOOR_IRT=0
CUSTOMER_FLOOR_IRT=-100
LOYAL_FLOOR_IRT=-500
OVERRIDE_FLOOR_LOWER_BOUND_IRT=-1000000

# --- Scheduling & Billing ---
RECONCILE_INTERVAL_MINUTES=5
WARN_RUNWAY_HOURS=24,6,1
DELETION_GRACE_MINUTES=60

# --- Hetzner Rate Windows ---
HETZNER_GLOBAL_PER_MINUTE=60
HETZNER_USER_PER_MINUTE=30
HETZNER_USER_CONCURRENCY=2
HETZNER_SYSTEM_RESERVE_PER_MINUTE=10

# --- Operating Systems Catalog ---
OS_DISTRIBUTIONS=ubuntu,debian
OS_CATALOG_REFRESH_MINUTES=15
OS_RESELECT_WINDOW_HOURS=72

# --- Web Tunnels ---
REVEAL_BASE_URL=https://reveal.internal.manova.space
ADMIN_BASE_URL=https://admin.internal.manova.space
