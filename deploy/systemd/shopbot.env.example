# Install as /etc/manova/shop-tgbot/shopbot.env with mode 0600.
# Loaded by manova-shop-tgbot.service

TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=<admin_telegram_id>
SUPPORT_HANDLE=@manova_support
CARD_HOLDER_NAME="<card_holder_name>"

RATE_SPREAD_IRT_PER_USD=5000
REQUOTE_THRESHOLD_IRT_PER_USD=5000

# Required for envelope encryption / phone hashing
CREDENTIAL_KEK=

# Database configuration
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=10000
DATABASE_USER="shop"
DATABASE_NAME="shop"
DATABASE_SSLMODE="disable"
DB_PASSWORD="..."
